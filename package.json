{
  "name": "league-soraka",
  "version": "0.5.4",
  "private": true,
  "description": "League Soraka: ARAM: Mayhem augment picks and champion-select ratings for DeepSeek Harness (screen-read overlay + OP.GG data).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "overlay-py/**/*.py",
    "skills/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/policy.test.mjs test/score.test.mjs test/matcher.test.mjs",
    "data:fetch": "node scripts/fetch-opgg.mjs",
    "data:icons": "node scripts/fetch-icons.mjs",
    "data:champions": "node scripts/fetch-champions.mjs",
    "build:index": "node scripts/build-icon-index.mjs"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
